<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 M3U8 视频解密助手"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 服务状态与控制卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C2E"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 监听服务已停止"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ 启动后台监听服务"
                android:backgroundTint="#38BDF8"
                android:textColor="#090D16"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 手机文件管理保存目录卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C2E"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未选择保存目录 (默认应用缓存)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSelectFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📂 打开手机文件管理选择保存文件夹"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <!-- 当前下载进度展示卡片 -->
        <LinearLayout
            android:id="@+id/cardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C2E"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在处理: 视频"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvCurrentStage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="正在下载分片..."
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCurrentPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#38BDF8"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSlicesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分片进度: 0 / 0"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 手动输入/发起区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C2E"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手动输入参数 (油猴脚本自动抓取可留空)"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etM3u8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="M3U8 播放列表 URL"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Base64 解密密钥 (Key)"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="视频文件名 (例如: 1.6 汇川中大型PLC主要功能简介)"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="所属章节文件夹 (可选，例如: 第1章 PLC基础篇)"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnStartLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ 开始下载与解密"
                android:backgroundTint="#10B981"
                android:textColor="#090D16"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 下载历史记录卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C2E"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📁 下载历史记录"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- 动态添加历史项目 -->
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无下载记录"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:gravity="center"
                android:padding="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
